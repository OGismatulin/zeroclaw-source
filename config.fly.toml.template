# ── Agents ──────────────────────────────────────────────────────────────────
# Each agent carries ONLY model_provider / risk_profile / runtime_profile. Dead
# per-agent allowed_tools + system_prompt dropped (behavior-neutral: the main
# agent runs Full and ignores allowed_tools; subagents inherit the shared
# risk_profile allowlist). All agents share risk_profile = "default" so the
# delegate gate (caller+target same profile) passes.

[agents.default]
model_provider = "opencode.go"
risk_profile = "default"
runtime_profile = "default"
mcp_bundles = ["all"]

[agents.jira_coordinator]
model_provider = "opencode.go_coordinator"
risk_profile = "default"
runtime_profile = "jira_analysis"
mcp_bundles = ["all"]

[agents.jira_worker]
model_provider = "opencode.go"
risk_profile = "default"
runtime_profile = "jira_analysis"
mcp_bundles = ["all"]

[agents.worker]
model_provider = "opencode.go"
risk_profile = "default"
runtime_profile = "agent_default"
mcp_bundles = ["all"]

[agents.coder]
model_provider = "openai.codex_coder"
risk_profile = "default"
runtime_profile = "agent_default"
mcp_bundles = ["all"]

# analyst_luna = GPT-5.6 Luna on the codex OAuth subscription (moved off the Go
# router 2026-08-19; replaced mimo-v2.5-pro 2026-08-16). Renamed (was
# analyst_mimo) for audit truth — pipeline diagnostics key on the agent name, so
# a stale name would misattribute every ensemble output. NOTE: this puts three
# roles (analyst_luna, analyst_terra, judge analyst_sol) in the openai-codex
# failure domain — a codex outage now takes out the judge and 2 of 5 analysts.
[agents.analyst_luna]
model_provider = "openai.codex_luna"
risk_profile = "default"
runtime_profile = "jira_analysis"
mcp_bundles = ["all"]
# Neutral analyst persona instead of the main-user identity: an explicit
# workspace.path survives fork patch #2 (schema.rs is_none() guard), so
# delegate's identity loop loads personas/analyst/IDENTITY.md here.
[agents.analyst_luna.workspace]
path = "/zeroclaw-data/template/workspace/personas/analyst"

[agents.analyst_deepseek_pro]
