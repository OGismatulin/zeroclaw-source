"hy3"                     = 256_000
# Codex-effective windows (NOT the 1.05M API / 400K published cap). The ChatGPT
# Codex backend reserves ~128K output + ~5% CLI headroom, so real usable input is
# ~258K (gpt-5.x) / ~353K (gpt-5.6). At 400K the 0.70 trigger (280K) sat ABOVE the
# ~258K real limit → codex rejected input before compaction ran (DV-34269 overflow,
