# gpt-5.5 stays after leaving the chat catalog — it is still the image_gen codex model.
"gpt-5.5"                 = 256_000
"gpt-5.6-sol"             = 353_000
"gpt-5.6-terra"           = 353_000
"gpt-5.6-luna"            = 353_000
# Probed 2026-08-22 (windows unpublished): ox-alpha-free accepted a 900k-token
# prompt; muse-spark-1.2-contributor accepted 600k and rejected 1M. Verified floor.
"ox-alpha-free"           = 800_000
"muse-spark-1.2-contributor" = 600_000

