# Native schema_version = 3 config (Fly volume seed for fresh deploys).
#
# Pre-V3 configs were V1→V3 migrated in-memory every boot; this template is
# authored natively in V3 shape so no migration runs. Spike 0 proved a
# hand-authored native-V3 config boots and resolves the boot-provider
# deterministically from [providers.models.opencode.go].
#
# Secret placeholders __ZEROCLAW_BEARER_TOKEN__ / __ZEROCLAW_WEBHOOK_SECRET__
# are substituted by the entrypoint/init sed at deploy time. api_key = "" stays
# empty everywhere (credentials resolve through env / Fly secrets), so a
# provider-specific placeholder never leaks to another provider.
schema_version = 3

# ── Providers ───────────────────────────────────────────────────────────────
# Boot-default = [providers.models.opencode.go]. normalize_provider_type(
# "opencode-go", "default") → opencode.go; the synthesized agents.default points
# its model_provider here. Model lives on the entry, NOT in ZEROCLAW_MODEL (V3
# ignores that env override).

# Single default model for the whole runtime = deepseek-v4-flash.
# ZEROCLAW_PROVIDER=opencode-go hard-maps to THIS alias (normalize_provider_type ->
# opencode.go) and the webhook default path reads the boot slot, not agents.default,
# so the default can only be changed here. default/worker/jira_worker all point at
# this one entry on purpose: one model everywhere, no per-agent split to keep in
# sync. go_coordinator is the same model with reasoning_effort = "max".
#
# Do NOT put a freshly launched Go slot here. Tried on 2026-08-22 and both reverted
# the same day: ox-alpha-free (v3-42/43) collected 24 "Endpoint is unavailable" 503s
# in one day of prod daemon-stderr -- zero for every other catalog model -- and burned
# a DV-34767 visual dispatch; muse-spark-1.2-contributor (v3-44) started answering 503
# too. Short client probes cannot tell these models apart (5/5, 4/5, 5/5 on heavy
# tool loops); the discriminator is the per-model 503 count in prod over a day.
# It matters more than for a chat model because delegates retry same-provider x3 with
# NO fallback by design (ensemble failure-domain invariant D2), so
# [reliability.model_fallbacks] never covers the ensemble, the visual worker or cron:
# the default model has to hold on its own. Both stay available as /model buttons,
# where retry + fallback do apply.
[providers.models.opencode.go]
model = "deepseek-v4-flash"
uri = "https://opencode.ai/zen/go/v1"
api_key = ""
# Go-router accepts reasoning_effort in the request body; deepseek gates the
# structured field to None, so we pass it via provider_extra (flattens into the
# body top-level). Separate knob from codex — config.runtime.reasoning_effort
# stays unset (codex default xhigh). Only low/medium/high/xhigh/max — NOT minimal (400).
provider_extra = { reasoning_effort = "high" }

# Isolated coordinator alias: same deepseek-v4-flash on the same Go endpoint, but
# reasoning_effort = "max" (Go-router valid — NOT minimal→400). Only
# [agents.jira_coordinator] points here; worker/default/jira_worker stay on
# opencode.go (high). Rollback = repoint jira_coordinator back to opencode.go and
# bump the marker. Spec: 2026-07-24-jira-judge-ensemble-input-integrity §5.3.
[providers.models.opencode.go_coordinator]
model = "deepseek-v4-flash"
uri = "https://opencode.ai/zen/go/v1"
api_key = ""
provider_extra = { reasoning_effort = "max" }

# Codex subagents fold under the `openai` family with the codex OAuth runtime
# (wire_api = "responses" + requires_openai_auth = true — what the V1→V3
# migration applies to "openai-codex"). worker = gpt-5.6-luna (cheap GPT-5.6
# tier; reachable on Codex only via fork patch #22 originator=codex_cli_rs —
# 404 under the old `pi` identity), coder = gpt-5.6-sol.
[providers.models.openai.codex_worker]
model = "gpt-5.6-luna"
api_key = ""
wire_api = "responses"
requires_openai_auth = true

[providers.models.openai.codex_coder]
model = "gpt-5.6-sol"
api_key = ""
wire_api = "responses"
requires_openai_auth = true

# GPT-5.6 analyst slots on the same codex OAuth runtime (GA on Codex
# 2026-07-09). sol = frontier tier, terra = balance tier (≈5.5 quality,
# 2x cheaper). Referenced by [agents.analyst_sol] / [agents.analyst_terra].
[providers.models.openai.codex_sol]
model = "gpt-5.6-sol"
api_key = ""
wire_api = "responses"
requires_openai_auth = true
# Per-alias thinking budget (fork patch #34, 2026-08-19): codex reads
# provider_extra.reasoning_effort the same way the compat families do, so each
# analyst alias sets its own level instead of sharing [runtime].reasoning_effort.
# The judge runs deliberately lower than the analysts it grades.
provider_extra = { reasoning_effort = "medium" }

[providers.models.openai.codex_terra]
model = "gpt-5.6-terra"
api_key = ""
wire_api = "responses"
requires_openai_auth = true
# Explicit rather than implicit: xhigh is also the codex default, but pinning it
# here keeps the alias unaffected by a future [runtime].reasoning_effort change.
provider_extra = { reasoning_effort = "xhigh" }

# analyst_luna moved off the Go router onto the codex OAuth subscription
# (2026-08-19). Same gpt-5.6-luna model, and `max` survives the move: fork patch
# #34 teaches the codex wire to read provider_extra.reasoning_effort per alias.
# Live-probed 2026-08-19: luna/terra/sol all answer 200 to max|xhigh|medium and
# echo back the requested effort. Referenced by [agents.analyst_luna].
[providers.models.openai.codex_luna]
model = "gpt-5.6-luna"
api_key = ""
wire_api = "responses"
requires_openai_auth = true
provider_extra = { reasoning_effort = "max" }

# deepseek subagents: pro (deepseek-v4-pro) and flash (deepseek-v4-flash).
[providers.models.deepseek.pro]
model = "deepseek-v4-pro"
api_key = ""
# Max thinking budget for the ensemble analyst. deepseek has no typed per-alias
# reasoning knob, so it goes through provider_extra (flattens to the request body
# top-level, bypassing the zeroclaw enum which caps at xhigh). api.deepseek.com
# accepts reasoning_effort = "max" on deepseek-v4-pro — probed 2026-08-19 (200,
# reasoning_tokens > the same prompt at "high").
provider_extra = { reasoning_effort = "max" }

[providers.models.deepseek.flash]
model = "deepseek-v4-flash"
api_key = ""

# GLM via the z.ai Coding Plan subscription. The provider name decides the endpoint:
# `zai` → https://api.z.ai/api/coding/paas/v4 (subscription, ZAI_API_KEY), while `glm`
# → https://api.z.ai/api/paas/v4 (pay-per-use credits). Probing the pay-per-use path
# answers 429 "Insufficient balance" even though the subscription is healthy — that is
# a wrong-endpoint symptom, not a dead account (glm-provider.md §4/§10).
# Backs [agents.analyst_glm]; glm-5.3 tool-loop verified on the subscription 2026-08-16.
[providers.models.zai.default]
model = "glm-5.3"
api_key = ""

# Bootstrap reference for fresh deploys; production overrides provider/model in
# fly.toml [env] (but V3 ignores ZEROCLAW_MODEL — boot default is opencode.go).
[providers.models.openrouter.default]
model = "google/gemini-3-flash-preview"
api_key = ""

[providers.models.minimax.default]
model = "minimax-m3"
api_key = ""

# Qwen analyst slot on the Go router (2026-08-21). Replaced the Cline provider,
# which was dropped together with the ClinePass subscription — the whole `custom`
# family is gone with it, so the bot offers no cline/* buttons either. Same model
# the analyst ran under Cline (qwen3.8-max), just on the Go subscription now.
# Re-probed against /zen/go/v1 on 2026-08-21: turn 1 returns a native tool_calls
# array and the multi-turn tool loop closes with HTTP 200 at high|xhigh|max. The
# 2026-08-16 note claiming qwen3.8-max answers 503 no longer holds (grok-4.5 still
# does). reasoning_effort = max matches the other ensemble analysts; note that the
# ceiling is per-model on this router — qwen3.7-plus rejects "max" with a 400.
# NO fallback — preserves the analyst failure domain (jira-analysis-pipeline D2:
# same-provider retry x3, no fallback).
[providers.models.opencode.qwen]
model = "qwen3.8-max"
uri = "https://opencode.ai/zen/go/v1"
api_key = ""
provider_extra = { reasoning_effort = "max" }

# ── Reliability ───────────────────────────────────────────────────────────
[reliability]
fallback_providers = ["opencode-go"]

[reliability.model_fallbacks]
# Re-synced to the live catalog 2026-08-16: retired ids (GLM-5.1, Qwen3.5-397B-A17B,
# gpt-5.5, gpt-5.4*, glm-5-turbo, glm-5.1, glm-5.2, minimax-m2.7, mimo-v2.5,
# kimi-k2.7-code) dropped. deepseek-v4-flash is the fallback target, so it is never
# a key.
# Codex family
"gpt-5.6-sol"        = ["deepseek-v4-flash"]
"gpt-5.6-terra"      = ["deepseek-v4-flash"]
"gpt-5.6-luna"       = ["deepseek-v4-flash"]
# Go-plan native opencode-go
"glm-5.3"            = ["deepseek-v4-flash"]
"kimi-k3"            = ["deepseek-v4-flash"]
"minimax-m3"         = ["deepseek-v4-flash"]
"mimo-v2.5-pro"      = ["deepseek-v4-flash"]
"qwen3.7-plus"       = ["deepseek-v4-flash"]
"qwen3.8-max"        = ["deepseek-v4-flash"]
"hy3"                = ["deepseek-v4-flash"]
"deepseek-v4-pro"    = ["deepseek-v4-flash"]
"ox-alpha-free"      = ["deepseek-v4-flash"]
"muse-spark-1.2-contributor" = ["deepseek-v4-flash"]

# ── Memory ──────────────────────────────────────────────────────────────────
[memory]
backend = "sqlite"
auto_save = true
embedding_provider = "openrouter"
embedding_model = "openai/text-embedding-3-small"
embedding_dimensions = 1536
# Core-memory durability: export category='core' → MEMORY_SNAPSHOT.md at each
# daemon spawn; auto_hydrate (default true) restores on cold-boot.
snapshot_enabled = true
snapshot_on_hygiene = true
# Native per-turn consolidation (fork): each answered turn → Daily history_entry
# + Core memory_update with conflict dedup (superseded_by). On by default (since
# 2026-06-17; serde default also true). Set false to opt a user out. Coexists
# with nightly-retrospective.
# Spec: docs/superpowers/specs/2026-06-16-native-per-turn-consolidation-design.md
consolidation_enabled = true

# sqlite_open_timeout_secs moved to [storage.<backend>.<alias>] in V3; [memory]
# backend = "sqlite" resolves to sqlite.default.
[storage.sqlite.default]
open_timeout_secs = 30

# ── Skills ──────────────────────────────────────────────────────────────────
[skills]
prompt_injection_mode = "compact"

# ── Observability ───────────────────────────────────────────────────────────
# MANDATORY (Spike 0): without it runtime-trace.jsonl stops writing and later
# gates fail. V3 field names log_persistence* are aliases of the old
# runtime_trace_* keys.
[observability]
backend = "none"
log_persistence = "rolling"
log_persistence_path = "logs/runtime-trace.jsonl"
log_persistence_max_entries = 5000

# ── Gateway ───────────────────────────────────────────────────────────────
# require_pairing = false (Spike 0): else child daemons 401 the manager's
# forwarded bearer token.
[gateway]
port = 3000
host = "127.0.0.1"
require_pairing = false
allow_public_bind = false
paired_tokens = ["__ZEROCLAW_BEARER_TOKEN__"]
trust_forwarded_headers = false
pair_rate_limit_per_minute = 0
webhook_rate_limit_per_minute = 0
rate_limit_max_keys = 10000
idempotency_ttl_secs = 300
idempotency_max_keys = 10000
# Webhook turns run long (heavy tool loops); pin the timeout in typed config
# instead of the former env-first fork shim. Fly still sets
# ZEROCLAW_GATEWAY_TIMEOUT_SECS for the Python manager's own request timeout.
request_timeout_secs = 1800
long_running_request_timeout_secs = 600

# Tunnel defaults to "none" in V3 (tunnel.tunnel_provider); no section needed.

# Webhook section stays spelled [channels_config.webhook]: the V3 runtime treats
# it as a legacy section and skips it (the embedded webhook channel is dead code
# here — the live path is the gateway crate's handle_webhook bound to [gateway]
# port), but gateway_manager._rewrite_gateway_config matches this literal block
# to inject each daemon's per-user port. Keep the literal name (do NOT rename to
# [channels.webhook.default] — that breaks the manager's port rewrite).
[channels_config]
cli = true

[channels_config.webhook]
port = 3000
secret = "__ZEROCLAW_WEBHOOK_SECRET__"

# ── Multimodal ──────────────────────────────────────────────────────────────
[multimodal]
max_images = 4
max_image_size_mb = 20
vision_provider = "openrouter"
vision_model = "google/gemini-3.1-flash-lite-preview"

# ── HTTP request tool ─────────────────────────────────────────────────────
[http_request]
enabled = true
allowed_domains = ["*"]
max_response_size = 100000
timeout_secs = 30

# ── Jira tool ───────────────────────────────────────────────────────────────
[jira]
enabled = true
base_url = "https://yallaclassifieds.atlassian.net"
email = "oleg.gismatulin@lalafo.com"
api_token = ""
# Full action surface (all 8 implemented in jira_tool.rs; verified against the
# deployed image before enabling -- an unknown action panics the daemon at boot).
# Write actions (comment_ticket, transition_ticket, create_ticket) are gated by
# the skill, not by config: the agent uses them only on explicit user request.
allowed_actions = [
    "get_ticket",
    "search_tickets",
    "comment_ticket",
    "list_projects",
    "myself",
    "list_transitions",
    "transition_ticket",
    "create_ticket",
]
timeout_secs = 30

# ── Delegate ──────────────────────────────────────────────────────────────
[delegate]
timeout_secs = 90
agentic_timeout_secs = 3600
# Server-side long-poll (seconds) for check_result on a still-Running task:
# waits up to this long, re-reading status every ~5s, returns early on
# terminal/reconciled-loss. Bounds orchestrator poll frequency so a slow
# sub-agent can't drain max_iterations before the coordinator launches
# downstream work (DV-34312). 0 = off (immediate return). Range 0..=300.
check_result_long_poll_secs = 60

# ── Heartbeat ─────────────────────────────────────────────────────────────
# Periodic HEARTBEAT.md tasks (e.g. Jira watchdog). V3 made `enabled` default
# false and `agent` required (must name a configured agent). agent = "default"
# = the synthesized main agent. interval/two_phase set explicitly so an
# upstream default-flip can't silently disable us again.
[heartbeat]
enabled = true
agent = "default"
interval_minutes = 30
two_phase = true

# ── MCP ─────────────────────────────────────────────────────────────────────
[mcp]
enabled = true
deferred_loading = false

[[mcp.servers]]
name = "context7"
transport = "http"
url = "https://mcp.context7.com/mcp"
tool_timeout_secs = 60

[[mcp.servers]]
name = "lalafo-db"
transport = "http"
url = "http://localhost:4000/mcp"
tool_timeout_secs = 120

[[mcp.servers]]
name = "graylog"
transport = "http"
url = "http://localhost:4001/mcp"
tool_timeout_secs = 120

# codemap-semantic: second remote MCP on the SAME box — natural-language semantic
# search over the monorepa (claude-context + Zilliz), for "how does X work / where is
# the logic for Y" where the symbol name is unknown. Its [mcp.servers.headers] MUST sit
# immediately below THIS block (headers attach to the last [[mcp.servers]]). Bearer seeded
# from CODEMAP_SEMANTIC_API_KEY via placeholder. Design: docs/superpowers/specs/2026-07-07-*.
[[mcp.servers]]
name = "codemap-semantic"
transport = "http"
url = "https://178-104-197-112.sslip.io/semantic/mcp"
tool_timeout_secs = 120

[mcp.servers.headers]
Authorization = "Bearer __CODEMAP_SEMANTIC_API_KEY__"

# codemap-fs: third remote MCP on the SAME box — read-only file access to the
# indexed monorepa (services/packages/prototypes) so the agent reads a file or a
# project's CLAUDE.md/README.md directly instead of hunting via glab api. Its
# [mcp.servers.headers] MUST sit immediately below THIS block (headers attach to
# the last [[mcp.servers]]). REUSES CODEMAP_API_KEY (Oleg #2 — one key, three
# routes). Design: docs/superpowers/specs/2026-07-15-*.
[[mcp.servers]]
name = "codemap-fs"
transport = "http"
url = "https://178-104-197-112.sslip.io/fs/mcp"
tool_timeout_secs = 120

[mcp.servers.headers]
Authorization = "Bearer __CODEMAP_API_KEY__"

# codemap: remote code-index MCP over the internet (Fly iad -> Hetzner EU).
# graph of the Lalafo monorepa (graphify). Bearer secret is seeded from
# CODEMAP_API_KEY via the __CODEMAP_API_KEY__ placeholder (no env-subst in
# MCP headers — mcp_transport.rs). Design: docs/superpowers/specs/2026-07-06-*.
[[mcp.servers]]
name = "codemap"
transport = "http"
url = "https://178-104-197-112.sslip.io/mcp"
tool_timeout_secs = 120

# WARNING: this sub-table attaches to the LAST mcp.servers entry above (codemap).
# Add new MCP servers ABOVE the codemap block, or move these headers with it.
[mcp.servers.headers]
Authorization = "Bearer __CODEMAP_API_KEY__"

# ── MCP bundles ─────────────────────────────────────────────────────────────
# v0.8.2 is secure-by-default: an agent with no `mcp_bundles` receives NO MCP
# servers (omission is not a grant — schema.rs mcp_servers_for_bundles). Pre-v0.8.2
# every agent got every [[mcp.servers]] globally; this bundle + per-agent
# `mcp_bundles = ["all"]` below restores that. Names match [[mcp.servers]].name.
[mcp_bundles.all]
servers = ["context7", "lalafo-db", "graylog", "codemap", "codemap-semantic", "codemap-fs"]

# ── Risk profile (default) ──────────────────────────────────────────────────
# Replaces the pre-V3 top-level [autonomy] block. Main agent runs at level=Full
# and ignores allowed_tools (gateway filters only excluded_tools when level !=
# Full); delegate targets REQUIRE a non-empty allowed_tools and use it as their
# filter — this superset of every subagent toolset gives subagents the same
# powers as main (regression #16 fix). delegation_policy.mode = "allow" + shared
# risk_profile is what makes the delegate gate pass.
[risk_profiles.default]
level = "full"
workspace_only = false
allowed_commands = [
    "git",
    "npm",
    "cargo",
    "sh",
    "ls",
    "cat",
    "grep",
    "find",
    "echo",
    "pwd",
    "wc",
    "head",
    "tail",
    "date",
    "wget",
    "python3",
    "pip",
    "pip3",
    "node",
    "npx",
    "ffmpeg",
    "convert",
    "pandoc",
    "curl",
    "jq",
    "agent-browser",
    "gh",
    "glab",
    "code_repos_sync.py",
]
forbidden_paths = [
    "/etc",
    "/root",
    "/home",
    "/usr",
    "/bin",
    "/sbin",
    "/lib",
    "/opt",
    "/boot",
    "/dev",
    "/proc",
    "/sys",
    "/var",
    "/tmp",
    "~/.ssh",
    "~/.gnupg",
    "~/.aws",
    "~/.config",
    "/zeroclaw-data/mcp_graylog",
]
require_approval_for_medium_risk = false
block_high_risk_commands = false
shell_env_passthrough = ["NOTIFY_URL", "NOTIFY_SECRET", "NOTIFY_FILE_URL", "OPENROUTER_API_KEY", "CREATIO_BASE_URL", "CREATIO_USERNAME", "CREATIO_PASSWORD", "PG_PROD_HOST", "PG_PROD_PORT", "PG_PROD_USER", "PG_PROD_PASSWORD", "PG_STAGE_HOST", "PG_STAGE_PORT", "PG_STAGE_USER", "PG_STAGE_PASSWORD", "GITLAB_DEPLOY_USER", "GITLAB_DEPLOY_TOKEN", "GOOGLE_SERVICE_ACCOUNT_JSON", "SCRAPECREATORS_API_KEY", "XAI_API_KEY", "BRAVE_API_KEY", "JIRA_API_TOKEN", "JWT_SIGNING_SECRET", "AGENT_BROWSER_PROFILE", "AGENT_BROWSER_SESSION", "AGENT_BROWSER_EXECUTABLE_PATH", "AGENT_BROWSER_ARGS", "ZEROCLAW_WORKSPACE", "GITHUB_TOKEN", "GITHUB_USER", "GITLAB_TOKEN", "GITLAB_HOST", "IMAGE_UPLOAD_AWS_ACCESS_KEY_ID", "IMAGE_UPLOAD_AWS_SECRET_ACCESS_KEY", "ADMIN_BASIC_USER", "ADMIN_BASIC_PASSWORD", "ADMIN_APP_EMAIL", "ADMIN_APP_PASSWORD", "ADMIN_OAUTH2_COOKIE", "MICROSOFT_SESSION_COOKIES", "OPENCODE_GO_API_KEY"]
auto_approve = [
    "file_read",
    "file_write",
    "memory_recall",
    "shell",
    "http_request",
]
always_ask = []
allowed_roots = ["/zeroclaw-data/code-repos"]
allowed_tools = [
    "file_read", "file_write", "file_edit", "content_search",
    "glob_search", "shell", "http_request", "web_fetch",
    "web_search_tool", "text_browser", "memory_recall", "memory_store",
    "memory_forget", "memory_export", "read_skill", "tool_search",
    "knowledge", "delegate", "swarm", "cron_add",
    "cron_list", "cron_remove", "cron_run", "cron_runs",
    "cron_update", "schedule", "model_switch", "model_routing_config",
    "claude_code", "codex_cli", "gemini_cli", "opencode_cli",
    "image_gen", "image_info", "pdf_read", "screenshot",
    "sessions_history", "sessions_list", "sessions_send", "workspace",
    "calculator", "counting", "project_intel", "llm_task",
    "report_template", "execute_pipeline", "git_operations", "sop_advance",
    "sop_approve", "sop_execute", "sop_list", "sop_status",
    "security_ops", "vi_verify", "notion", "jira",
    "linkedin", "google_workspace", "microsoft365", "discord_search",
    "composio", "context7__resolve-library-id", "context7__query-docs", "lalafo-db__query",
    "lalafo-db__query_file", "lalafo-db__databases", "lalafo-db__ch_query", "lalafo-db__ch_databases",
    "lalafo-db__ch_tables", "lalafo-db__query_to_file", "lalafo-db__ch_query_to_file", "lalafo-db__health",
    "graylog__health", "graylog__count", "graylog__search", "graylog__by_request_id",
    "graylog__by_user", "graylog__search_to_file",
